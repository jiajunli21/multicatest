generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             BigInt    @id @default(autoincrement())
  userId         String    @unique @map("user_id") @db.VarChar(64)
  balance        BigInt    @default(0) @map("balance")
  frozenBalance  BigInt    @default(0) @map("frozen_balance")
  totalEarned    BigInt    @default(0) @map("total_earned")
  totalSpent     BigInt    @default(0) @map("total_spent")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  transactions Transaction[]
  freezes      Freeze[]

  @@map("accounts")
}

model Transaction {
  id             BigInt    @id @default(autoincrement())
  idempotentKey  String    @unique @map("idempotent_key") @db.VarChar(128)
  userId         String    @map("user_id") @db.VarChar(64)
  type           String    @db.VarChar(16)
  amount         BigInt
  balanceBefore  BigInt    @map("balance_before")
  balanceAfter   BigInt    @map("balance_after")
  freezeId       BigInt?   @map("freeze_id")
  remark         String?   @db.VarChar(256)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [userId], references: [userId])
  freeze  Freeze? @relation(fields: [freezeId], references: [id])

  @@index([userId, createdAt(sort: Desc)], map: "idx_transactions_user_id_created_at")
  @@index([type], map: "idx_transactions_type")
  @@map("transactions")
}

model Freeze {
  id             BigInt    @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  amount         BigInt
  status         String    @default("active") @db.VarChar(16)
  idempotentKey  String    @unique @map("idempotent_key") @db.VarChar(128)
  frozenAt       DateTime  @default(now()) @map("frozen_at") @db.Timestamptz()
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  releasedAt     DateTime? @map("released_at") @db.Timestamptz()
  remark         String?   @db.VarChar(256)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account      Account       @relation(fields: [userId], references: [userId])
  transactions Transaction[]

  @@index([userId, status], map: "idx_freezes_user_id_status")
  @@index([expiresAt], map: "idx_freezes_expires_at")
  @@map("freezes")
}
